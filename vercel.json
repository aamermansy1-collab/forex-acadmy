{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "src/app/mcp/route.ts": { "maxDuration": 300 },
    "src/app/api/jobs/*/route.ts": { "maxDuration": 300 },
    "src/app/api/upload/route.ts": { "maxDuration": 120 }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 3 * * *"
    }
  ]
}
